# Temporary admin login (no database required).
# Set to false once DigitalOcean Postgres and the auth API are ready.
VITE_USE_LOCAL_ADMIN=true
VITE_ADMIN_USERNAME=admin@fire-dash.local
VITE_ADMIN_PASSWORD=change-me

# Test account for subscription flow (local admin mode only).
VITE_TEST_USERNAME=test@fire-dash.local
VITE_TEST_PASSWORD=Admin1234!

