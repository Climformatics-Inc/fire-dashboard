# Temporary admin login (no database required).
# Set to false once DigitalOcean Postgres and the auth API are ready.
VITE_USE_LOCAL_ADMIN=true
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=change-me

# Full auth API — enable when the database is live:
# VITE_USE_LOCAL_ADMIN=false
# VITE_AUTH_MODE=api
# VITE_AUTH_API_URL=http://127.0.0.1:3001
